# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.claude
.env
nul
.venv

# testing
/coverage
/.test-build/
/test-results/
/playwright-report/
__pycache__/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (none required by the app, but ignore stragglers anyway)
.env
.env.*

# vercel
.vercel

# local SQLite transient files only — the .sqlite database itself is committed
# (see data/ayna.sqlite) so a fresh clone is usable without re-running the scrapers.
/data/*.sqlite-journal
/data/*.sqlite-wal
/data/*.sqlite-shm

# typescript
*.tsbuildinfo
next-env.d.ts
